# Secrets and local configuration
.env
.env.*
!.env.example

# Python caches and virtual environments
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv*/
venv/
env/

# IDE and OS files
.DS_Store
.idea/
.vscode/

# Generated benchmark workspaces
temp_*/
temp_pybughive*/
temp_quixbugs/

# Large/generated datasets, indexes, and cloned repos
data/indexes/
data/codegen_index/
data/external_sources/
data/*.index
data/corpora/*.jsonl

# Committed CI fixtures (small, reproducibility exception to the rules above)
!data/ci/
!data/ci/*

# Raw/generated experiment outputs
experiments/*
!experiments/*.md
!experiments/analysis/
experiments/analysis/*
!experiments/analysis/*.py
!experiments/case_studies/
!experiments/case_studies/**/*.md
# Archived CI per-case results cited by the paper
!experiments/ci_run3_results/
!experiments/ci_run3_results/*.json

# Backups and logs
backups/
*.log

# Packaging/build outputs
build/
dist/
*.egg-info/
# (dist/ also holds the generated anonymized replication zip)

# LaTeX build artifacts (paper/)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
paper/*.fls
paper/*.fdb_latexmk
paper/hyperxmp.sty
